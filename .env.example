# Copy this file to `.env` and put your own token in it.
#
#   1. github.com > Settings > Developer settings > Personal access tokens
#   2. Fine-grained token for the IE2 repo with Contents: read and write,
#      or a classic token with the `repo` scope
#   3. Paste it below, save, and `npm run release` will find it every time
#
# `.env` is gitignored. This example file is not — never put a real token here.

GH_TOKEN=ghp_replace_me
